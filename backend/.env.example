# 複製為 .env(不入版控);部署區差異見 AGENT.md §6。測試區由 deploy/docker-compose.yml 提供,不用 .env
# dev:本機開發,不自動註冊 / test:測試區 / prod:正式區(test、prod 啟動時自動註冊 API 為 Gateway 草稿)
GW_ENV=dev
SERVICE_CODE=netops-api
PORT=51292
# Gateway 位址(自動註冊、路由查詢、JWKS 皆經此)
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
# 選用,預設 {GW_BASE_URL}/.well-known/jwks.json
# GW_JWKS_URL=
# API Key:dev 可用 GW_API_KEY(只有查詢既有路由 gw:lookup 需要);test / prod 一律用 GW_API_KEY_FILE(Docker secret)
GW_API_KEY=
# 監控(giga-observe):dev 預設關閉
# MONITOR_URL=
# MONITOR_API_KEY=
# MONITOR_ENABLED=true

# ---------- NetOps(B1;AGENT.md §6、backend/src/config.ts) ----------
# 資料目錄(絕對路徑);dev 未設定時用系統暫存目錄 giga-netops-dev。test / prod 必填
# NETOPS_DATA_DIR=
# FTP:dev 不設定 FTP_HOST 時 FTP 功能回 503;test / prod 必填。密碼 test / prod 用 FTP_PASSWORD_FILE
# FTP_HOST=10.10.130.66
# FTP_PORT=21
# FTP_USER=
# FTP_PASSWORD=
# FTP_PASSWORD_FILE=
# FTP_SECURE=0
# FTP_TLS_INSECURE=0
# FTP_ROOT=/
# FTP_LOG_DIR=/
# FTP_PATTERN=\.(csv|log|txt|gz)$
# FTP_AD_DIR=/AD_Log_Backup
# PA 其他類型 log 的目錄,設成 - 表示不匯入:FTP_THREAT_DIR、FTP_URL_DIR、FTP_DATA_FILTER_DIR、FTP_WILDFIRE_DIR、
#   FTP_DECRYPTION_DIR、FTP_GLOBALPROTECT_DIR、FTP_USERID_DIR(預設同舊版)
# 同時 FTP 連線上限(匯入與明細查詢共用;1–6)、自動同步間隔(分鐘,0 = 不自動)
# FTP_MAX_CONNECTIONS=1
# FTP_SYNC_MINUTES=0
# 明細查詢:最多幾筆、最多掃描幾秒(10–600)
# PA_SEARCH_LIMIT=2000
# PA_SEARCH_SECONDS=180
