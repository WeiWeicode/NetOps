# 複製為 .env(不入版控);部署區差異見 AGENT.md §6。測試區由 deploy/docker-compose.yml 提供,不用 .env
# dev:本機開發,不自動註冊 / test:測試區 / prod:正式區(test、prod 啟動時自動註冊 API 為 Gateway 草稿)
GW_ENV=dev
SERVICE_CODE=netops-api
PORT=51292
# Gateway 位址(自動註冊、路由查詢、JWKS 皆經此)
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
# 選用,預設 {GW_BASE_URL}/.well-known/jwks.json
# GW_JWKS_URL=
# API Key:dev 可用 GW_API_KEY(只有查詢既有路由 gw:lookup 需要);test / prod 一律用 GW_API_KEY_FILE(Docker secret)
GW_API_KEY=
# 監控(giga-observe):dev 預設關閉
# MONITOR_URL=
# MONITOR_API_KEY=
# MONITOR_ENABLED=true
