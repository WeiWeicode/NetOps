# 複製為 .env(不入版控);部署區差異見 AGENT.md §6。測試區由 deploy/docker-compose.yml 提供,不用 .env
# dev:本機開發,不自動註冊 / test:測試區 / prod:正式區(test、prod 啟動時自動註冊 API 為 Gateway 草稿)
GW_ENV=dev
SERVICE_CODE=netops-api
PORT=51292
# Gateway 位址(自動註冊、路由查詢、JWKS 皆經此)
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
# 選用,預設 {GW_BASE_URL}/.well-known/jwks.json
# GW_JWKS_URL=
# API Key:dev 可用 GW_API_KEY(只有查詢既有路由 gw:lookup 需要);test / prod 一律用 GW_API_KEY_FILE(Docker secret)
GW_API_KEY=
# 監控(giga-observe):dev 預設關閉
# MONITOR_URL=
# MONITOR_API_KEY=
# MONITOR_ENABLED=true

# ---------- NetOps(B1;AGENT.md §6、backend/src/config.ts) ----------
# 資料目錄(絕對路徑);dev 未設定時用系統暫存目錄 giga-netops-dev。test / prod 必填
# NETOPS_DATA_DIR=
# FTP:dev 不設定 FTP_HOST 時 FTP 功能回 503;test / prod 必填。密碼 test / prod 用 FTP_PASSWORD_FILE
# FTP_HOST=10.10.130.66
# FTP_PORT=21
# FTP_USER=
# FTP_PASSWORD=
# FTP_PASSWORD_FILE=
# FTP_SECURE=0
# FTP_TLS_INSECURE=0
# FTP_ROOT=/
# FTP_LOG_DIR=/
# FTP_PATTERN=\.(csv|log|txt|gz)$
# FTP_AD_DIR=/AD_Log_Backup
# PA 其他類型 log 的目錄,設成 - 表示不匯入:FTP_THREAT_DIR、FTP_URL_DIR、FTP_DATA_FILTER_DIR、FTP_WILDFIRE_DIR、
#   FTP_DECRYPTION_DIR、FTP_GLOBALPROTECT_DIR、FTP_USERID_DIR(預設同舊版)
# 同時 FTP 連線上限(匯入與明細查詢共用;1–6)、自動同步間隔(分鐘,0 = 不自動)
# FTP_MAX_CONNECTIONS=1
# FTP_SYNC_MINUTES=0
# 明細查詢:最多幾筆、最多掃描幾秒(10–600)
# PA_SEARCH_LIMIT=2000
# PA_SEARCH_SECONDS=180

# ---------- AI(A1;ARCHITECTURE D23、PA-LIVE-PLAN §6) ----------
# 模型(vLLM,OpenAI 相容);LLM_URL 空白 = AI 分析 / 問答 / 外部 IP 自動學習回 409。.45 配置相同,換主機只改這裡
# 開發機到 AI 主機會被 PA 擋(舊版走 SSH tunnel),本機開發通常不設定
# LLM_URL=http://10.10.130.46:8080/v1
# LLM_MODEL=Qwen3.6-35B-A3B-FP8
# LLM_API_KEY_FILE=
# LLM_TIMEOUT_MS=300000
# embedding 與向量庫(沿用舊版 Qdrant 的 NetOpsKb;QDRANT_URL 空白 = 不使用,問答改用關鍵字 / IP 比對)
# EMBED_URL=http://10.10.130.46:8081/v1
# QDRANT_URL=http://10.10.130.46:6333
# QDRANT_COLLECTION=NetOpsKb
# QDRANT_API_KEY_FILE=
# 是否把筆記寫進向量庫(1 / 0,預設 0:舊版 IIS 仍在同步同一個 collection,兩邊都同步會互刪對方的筆記)
# VECTOR_SYNC=0
# 外部 IP 自動學習:每天幾點(-1 = 不自動,預設)、看最近幾天、一次最多查幾個新 IP、查過的 IP 幾天內不重查
# IPLEARN_HOUR=-1
# IPLEARN_DAYS=7
# IPLEARN_MAX=150
# IPLEARN_TTL_DAYS=90
# 每次送給 AI 的知識庫最多幾個字;AI 串流同時上限(全系統、每人)
# KB_MAX_CHARS=20000
# AI_MAX_STREAMS=6
# AI_MAX_STREAMS_PER_USER=2
