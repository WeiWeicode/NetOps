{
  "name": "@giganexus/netops-api",
  "version": "0.1.0",
  "private": true,
  "description": "GigaNexus 資訊網通管理系統後端 netops-api(Node.js + Fastify):經 BFF /api/netops/*,只信任 X-Internal-Token(docs/ARCHITECTURE.md)",
  "type": "module",
  "gateway": {
    "project": "NetOps"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "test:int": "tsx --test --test-concurrency=1 test/integration/*.int.test.ts",
    "openapi": "tsx src/print-openapi.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.1",
    "@giganexus/backend-sdk": "^0.3.0",
    "basic-ftp": "6.2.3",
    "fastify": "5.12.5",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "jose": "6.2.12",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
