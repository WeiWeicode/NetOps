# netops-api 正式區 Compose 變數(主機 3 的 /srv/giganexus/deploy/netops.env;不入版控)。實際內容由 deploy/host3-set-secrets.sh、host3-set-pa-secrets.sh 寫入,以腳本為準;
# 本檔只列欄位與說明。不要複製成 /srv/giganexus/deploy/prod.env(那是正式區 Gateway 的設定)
GW_ENV=prod
GW_BASE_URL=https://giganexus.gigasolar.com.tw
GW_NETWORK=giganexus-gw_default
# 機密目錄(uid 1000 可讀):見 docker-compose.yml 開頭;正式區只接受 *_FILE
NETOPS_SECRETS_DIR=/srv/giganexus/netops-secrets
# 資料目錄(WSL 檔案系統,不放 /mnt/c;uid 1000 可寫;AGENT.md §6)
NETOPS_DATA_HOST_DIR=/srv/giga-netops/prod
# FTP(密碼在機密目錄 ftp_password)。目錄(FTP_ROOT、FTP_LOG_DIR、FTP_AD_DIR、各類型目錄)寫在 .gitlab-ci.yml deploy-prod,
#   會蓋過這裡的值,這裡不用設定(出處見 deploy/RUNBOOK-prod.md §1)
FTP_HOST=10.10.130.66
FTP_USER=
FTP_MAX_CONNECTIONS=2
# 第一段每 60 分鐘自動同步(需求方 2026-11-16;CI deploy-prod 固定:開關 0 時 60、1 時 0);第二段改 clickhouse 時移除
FTP_SYNC_MINUTES=60
# ---- 第一段(C6 前):以下值 CI deploy-prod 在 NETOPS_PA_PIPELINE=0 時也會固定 ----
NETOPS_AI_SOURCE=ftp
NETOPS_AI_DAILY_SUMMARY=0
NETOPS_ARCHIVE_ENABLED=0
# 歸檔保留天數(CG §10.3):0 = 不刪
NETOPS_ARCHIVE_KEEP_DAYS=0
# PA log 管線開關:0 = 不啟動 netops-clickhouse / netops-ingest / netops-pa;第二段 C6 改 1(RUNBOOK-prod.md §4)
NETOPS_PA_PIPELINE=0
# 正式區 ClickHouse 容器 2 GB(伺服器上限 1.5 GiB;CG §4.5)
NETOPS_CH_MEM_LIMIT=2048m
# 舊版 IIS 仍同步同一個 Qdrant collection(NetOpsKb):不寫入向量庫、不自動外部 IP 學習(D10、D18)
VECTOR_SYNC=0
IPLEARN_HOUR=-1
# PA 收集器(deploy/host3-set-pa-secrets.sh 會補上;第二段才用)。PA-560 管理介面是出廠自簽憑證時可設 PA_TLS_INSECURE=1(需求方 2026-11-17)
PA_POLL_ENABLED=0
PA_RECEIVE_ENABLED=0
PA_QUERY_ENABLED=0
PA_HOST=
PA_ALLOWED_SOURCES=
# PA_CA_FILE=/run/pa-tls/<公司 CA>.crt
# 以下有預設值,與預設相同時不用設定
# GW_WWW_VOLUME=giganexus-gw_gw_www
# NETOPS_KB_BACKUP_HOST_DIR=/mnt/nas-docker/giga-netops/prod
# NETOPS_ARCHIVE_HOST_DIR=/mnt/nas-docker/giga-netops/prod/pa-archive
# KB_BACKUP_HOUR=2
# KB_BACKUP_KEEP=30
# KB_BACKUP_DATA_KEEP=7
# KB_BACKUP_MIN_FREE_MB=2048
# NETOPS_REDIS_MAXMEMORY=2gb
