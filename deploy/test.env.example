# netops-api 測試區 Compose 變數範本(主機 2 的 /srv/giganexus/deploy/netops.env;不入版控;deploy/host2-set-secrets.sh 會自動產生)
GW_ENV=test
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
GW_NETWORK=giganexus-gw_default
# 機密目錄(uid 1000 可讀):見 docker-compose.yml 開頭
NETOPS_SECRETS_DIR=/srv/giganexus/netops-secrets
# 資料目錄(WSL 檔案系統,不放 /mnt/c;uid 1000 可寫;AGENT.md §6)
NETOPS_DATA_HOST_DIR=/srv/giga-netops/test
# FTP(密碼在機密目錄 ftp_password);目錄與舊版 IIS 的 server/.env 相同,未設定時用程式預設值
FTP_HOST=10.10.130.66
FTP_USER=
# FTP_ROOT=/
# FTP_LOG_DIR:測試區由 CI deploy-api-test 設為 /my-data(會蓋過這裡的值;.gitlab-ci.yml),這裡不用設定
# FTP_AD_DIR=/AD_Log_Backup
FTP_MAX_CONNECTIONS=1
FTP_SYNC_MINUTES=0
# AI(A1):預設 LLM / embedding / Qdrant 都在 10.10.130.46(docker-compose.yml);改用 .45 備用時在這裡覆寫,例如
# LLM_URL=http://10.10.130.45:8080/v1
# EMBED_URL=http://10.10.130.45:8081/v1
# Qdrant API Key 在機密目錄 qdrant_api_key。VECTOR_SYNC=1 會寫入向量庫(與舊版共用 NetOpsKb,D18 切換後才開)
# VECTOR_SYNC=0
# IPLEARN_HOUR=-1
# AI 資料來源(AC2):空白 = 依 GW_ENV(測試區 clickhouse、正式區 ftp;正式區 C6 後才改 clickhouse)
# NETOPS_AI_SOURCE=clickhouse
# 以下有預設值,與預設相同時不用設定(D1)
# Gateway 的 SPA volume(前端 spa-netops 發佈到 /srv/www/netops)
# GW_WWW_VOLUME=giganexus-gw_gw_www
# 知識庫 NAS 備份(netops-kb-backup):目的目錄、每天幾點(0–23)、保留份數;目錄與標記檔由 deploy/host2-setup-kb-backup.sh 建立
# NETOPS_KB_BACKUP_HOST_DIR=/mnt/nas-docker/giga-netops/test
# KB_BACKUP_HOUR=2
# KB_BACKUP_KEEP=30
# PA 即時監控(R1,netops-pa;deploy/host2-set-pa-secrets.sh 會補上):測試區預設關閉,測試時才開(2026-11-05 需求方決定)
#   PA_POLL_ENABLED=1 需要 PA_HOST 與機密 pa_api_key;PA_RECEIVE_ENABLED=1 需要 PA_ALLOWED_SOURCES 與機密 pa_http_token
#   步驟見 docs/PA-FORWARDING-SPEC.md 附錄 F
PA_POLL_ENABLED=0
PA_RECEIVE_ENABLED=0
PA_HOST=
# 容器看到的來源(經 Windows portproxy 時是 Docker 閘道,不是 PA-560;附錄 F.3)
PA_ALLOWED_SOURCES=
# PA_PORT=443
# PA_POLL_SECONDS=15
# PA-560 管理介面自簽憑證、尚未取得憑證時才設(只限測試區)
# PA_TLS_INSECURE=1
# netops-redis 記憶體上限(2026-11-04 決定 2gb)
# NETOPS_REDIS_MAXMEMORY=2gb
