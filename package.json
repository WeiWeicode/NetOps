{
  "name": "netops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5281",
    "server": "node --env-file=server/.env.development --watch server/index.js",
    "dev:all": "concurrently -n api,web -c green,cyan \"npm:server\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "themes": "node scripts/make-themes.mjs",
    "start": "node server/index.js",
    "publish": "vite build && node scripts/publish.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "activedirectory2": "^2.2.0",
    "axios": "^1.15.2",
    "basic-ftp": "^6.2.3",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.4",
    "element-plus": "^2.13.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.1.1",
    "mssql": "^12.7.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.2.4",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.10"
  }
}
