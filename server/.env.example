# 資訊網通管理系統後端設定（複製為 server/.env 後修改）
PORT=3081
# IIS 虛擬目錄；API 會同時掛在 /api 與 /NetOps/api
BASE_PATH=/NetOps
# JWT 金鑰：每個系統各自產生，不要和其他系統共用
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h
APP_URL=https://gsmc-web.gigasolar.com.tw/NetOps

# 主資料庫 PortalSolar（同一台需能查 LOS、GscSystem 做登入驗證）
DB_SERVER=10.10.130.220
DB_USER=
DB_PWD=
DB_NAME=PortalSolar

SYNC_PARAGRAM=NetOps
VIEW_USERS=
VIEW_DEPTS=

# PA 防火牆 log 的 FTP
FTP_HOST=10.10.130.66
FTP_PORT=21
FTP_USER=
# 密碼含 # 時要用引號包住，例如 FTP_PWD='ab#cd'
FTP_PWD=
FTP_SECURE=0
FTP_ROOT=/
FTP_LOG_DIR=/my-data
# PA 其他類型 log 的目錄（安全事件頁）；設成 - 表示不匯入
FTP_THREAT_DIR=/threat
FTP_URL_DIR=/url-filtering
FTP_DATA_FILTER_DIR=/data-filtering
FTP_WILDFIRE_DIR=/wildfire-submissions
FTP_DECRYPTION_DIR=/decryption
FTP_GLOBALPROTECT_DIR=/globalprotect
FTP_USERID_DIR=/user-id
FTP_PATTERN='\.(csv|log|txt|gz)$'
FTP_SYNC_MINUTES=0
# 同時開幾條 FTP 連線分析檔案（1~6）
FTP_PARALLEL=2

PA_LOG_DIR=uploads/palogs
PA_LOG_KEEP_DAYS=30

# AI 分析 / 問答：公司內部 vLLM（OpenAI 相容 API）；LLM_MODEL 指定問答模型（10.10.130.45 另有翻譯模型，不要用到它）；空白 = 自動使用第一個模型
LLM_URL=http://10.10.130.45:8080/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=300000

# 知識庫：管理者在 AI 問答請 AI 記錄的筆記（.md），之後問答時當參考
KB_DIR=uploads/knowledge
# 可以記錄 / 新增 / 刪除筆記的工號（逗號分隔）；空白 = VIEW_USERS 的人
KB_ADMINS=
KB_MAX_CHARS=20000
# 外部 IP 自動學習：防火牆 log 的公網 IP 查 RDAP / DNS 反查，AI 整理進知識庫（標籤「自動學習」）
# 每天幾點自動跑（-1 = 不自動）、看最近幾天的 log、一次最多查幾個新 IP、查過的 IP 幾天內不重查
IPLEARN_HOUR=3
IPLEARN_DAYS=7
IPLEARN_MAX=150
IPLEARN_TTL_DAYS=90

# 知識庫向量資料庫：10.10.130.46 的 Qdrant（collection NetOpsKb），embedding 用 10.10.130.45:8081 Qwen3-Embedding-8B；QDRANT_URL 空白 = 不使用
QDRANT_URL=http://10.10.130.46:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=NetOpsKb
EMBED_URL=http://10.10.130.45:8081/v1

# 選單「Veeam 備份監控」：同步登入跳轉（寫入 SyncLoginInfo 後開啟 {VEEAM_URL}/SyncLogin）
VEEAM_URL=https://gsmc-web.gigasolar.com.tw/Veeam
VEEAM_SYNC_PARAGRAM=Veeam

# 翻譯（AI 回答的「翻譯」按鈕）：與 AiService 會議翻譯相同用 .45 的 Qwen（關閉思考）；空白 = 沿用 LLM_URL / LLM_MODEL
TRANSLATE_URL=
TRANSLATE_MODEL=


# AD 網域控制站事件記錄：FTP 上每天一個資料夾（yyyyMMdd），內含 Security / System / Directory_Service / DNS_Server.csv
FTP_AD_DIR=/AD_Log_Backup
AD_DATA_DIR=uploads/adlogs
